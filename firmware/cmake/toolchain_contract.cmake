# Kept independent of project() so the rejection paths are host-testable.
function(contactmic_check_toolchain)
    if(NOT DEFINED ENV{IDF_PATH} OR "$ENV{IDF_PATH}" STREQUAL "")
        message(FATAL_ERROR "Activate ESP-IDF v5.5.5 first: IDF_PATH is not set.")
    endif()
    if(NOT EXISTS "$ENV{IDF_PATH}/tools/cmake/version.cmake")
        message(FATAL_ERROR "IDF_PATH does not contain an ESP-IDF version.cmake.")
    endif()
    include("$ENV{IDF_PATH}/tools/cmake/version.cmake")
    set(actual "${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}.${IDF_VERSION_PATCH}")
    if(NOT actual STREQUAL "5.5.5")
        message(FATAL_ERROR "ContactMic requires ESP-IDF v5.5.5; found ${actual}.")
    endif()
    if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL "esp32s3")
        message(FATAL_ERROR "ContactMic requires IDF_TARGET=esp32s3; found ${IDF_TARGET}.")
    endif()
    if(DEFINED ENV{IDF_TARGET} AND NOT "$ENV{IDF_TARGET}" STREQUAL "esp32s3")
        message(FATAL_ERROR "ContactMic requires IDF_TARGET=esp32s3; check the environment.")
    endif()
endfunction()
